{
  "manifest_version": 3,
  "name": "PS Builder Recorder",
  "version": "0.1.0",
  "description": "Records browser activity and exports a recording.md that Claude + the Process Street MCP can turn into a workflow.",
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "scripting",
    "webNavigation",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PS Builder Recorder"
  }
}
